X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# OpenRouter key: embeddings (openai/text-embedding-3-small) for the reads worldview check
OPENROUTER_API_KEY=
